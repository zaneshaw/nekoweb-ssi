{
	"name": "nekoweb-ssi",
	"module": "main.ts",
	"scripts": {
		"dev": "bun run --watch ./src/main.ts",
		"serve": "bun run ./src/main.ts",
		"build": "bun build ./src/main.ts --compile --outfile ssi-server --define 'process.env.BUILD=\"true\"'"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"prettier": "^3.8.1",
		"prettier-plugin-sort-imports": "^1.8.9"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"private": true,
	"type": "module"
}
